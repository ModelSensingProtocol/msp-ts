{
  "name": "msp-ts",
  "version": "0.1.0",
  "description": "MSP（Model Sensing Protocol）的 TypeScript 实现 —— 与 msp-py 线格式互通",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:interop": "node --test \"test/interop/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "demo": "node examples/hello.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxh230802/msp-ts.git"
  },
  "homepage": "https://github.com/hxh230802/msp-ts#readme",
  "bugs": {
    "url": "https://github.com/hxh230802/msp-ts/issues"
  },
  "keywords": [
    "msp",
    "model-sensing-protocol",
    "protocol",
    "multi-agent",
    "typescript",
    "zero-dependency"
  ]
}
